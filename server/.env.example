# ---- Server ----
PORT=4000
# Set to 1 when running behind nginx / a load balancer that terminates HTTPS (so rate limits see the real IP)
TRUST_PROXY=0
NODE_ENV=development

# ---- Database (MySQL 8 / MariaDB 10.6+) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bluesparks
DB_PASSWORD=bluesparks
DB_NAME=bluesparks

# ---- Auth ----
# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# First admin user, created by `npm run db:setup`
ADMIN_EMAIL=admin@bluesparks.co.tz
ADMIN_PASSWORD=ChangeMe123!

# ---- URLs ----
# Where the React client is served (CORS origin)
CLIENT_ORIGIN=http://localhost:5173
# Public website URL (used in emails and payment redirects)
PUBLIC_URL=http://localhost:5173
# Public URL of this API (used for payment callbacks and iCal export links)
API_PUBLIC_URL=http://localhost:4000

# ---- Email (SMTP). Leave SMTP_HOST empty to log emails to the console instead of sending ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bluesparks Holdings <bookings@bluesparks.co.tz>"

# ---- Payments ----
# mock = fake checkout page for local testing. flutterwave = real gateway.
PAYMENT_GATEWAY=mock
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Secret hash you set in the Flutterwave dashboard > Settings > Webhooks
FLUTTERWAVE_WEBHOOK_HASH=

# ---- WhatsApp (Meta Cloud API). Leave empty to skip sending (click-to-chat links still work) ----
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=

# ---- Uploads ----
# Relative to the server folder or absolute. images/ is served publicly, private/ is admin-only.
UPLOAD_DIR=./uploads
