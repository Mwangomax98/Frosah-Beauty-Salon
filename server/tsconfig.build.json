{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true
  },
  "include": ["src", "../shared/src"],
  "tsc-alias": { "resolveFullPaths": true, "verbose": false }
}
